<Window x:Class="DeejFeedback.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deej Feedback 0.2.1-preview" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Closing="OnClosing" StateChanged="OnWindowStateChanged">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18" Background="{StaticResource BackgroundBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="54" Height="54" CornerRadius="13" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
          <Viewbox Margin="9">
            <Canvas Width="36" Height="36">
              <Line X1="6" Y1="4" X2="6" Y2="32" Stroke="#10131A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Line X1="14" Y1="4" X2="14" Y2="32" Stroke="#10131A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Line X1="22" Y1="4" X2="22" Y2="32" Stroke="#10131A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Line X1="30" Y1="4" X2="30" Y2="32" Stroke="#10131A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Canvas.Left="2" Canvas.Top="8" Width="8" Height="8" Fill="#10131A"/>
              <Ellipse Canvas.Left="10" Canvas.Top="21" Width="8" Height="8" Fill="#10131A"/>
              <Ellipse Canvas.Left="18" Canvas.Top="12" Width="8" Height="8" Fill="#10131A"/>
              <Ellipse Canvas.Left="26" Canvas.Top="24" Width="8" Height="8" Fill="#10131A"/>
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="deej" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text=" feedback" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          </StackPanel>
          <TextBlock Text="Hardware mixer with Windows audio feedback" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,8">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="#E15B64" Margin="0,0,8,0"/>
          <TextBlock x:Name="ConnectionText" Text="Controller disconnected" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnMainTabSelectionChanged">
      <TabItem x:Name="MixerTab" Header="Mixer">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChannelCards"/></ScrollViewer>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="Microphone privacy" FontSize="20" FontWeight="SemiBold"/>
              <Border x:Name="PrivacyBanner" Background="#29423E" CornerRadius="8" Padding="14" Margin="0,14">
                <StackPanel>
                  <TextBlock x:Name="PrivacyTitle" Text="MICROPHONE AVAILABLE" FontSize="17" FontWeight="Bold"/>
                  <TextBlock x:Name="PrivacyDetail" Text="An input may be available to applications." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Button x:Name="PrivacyButton" Content="Toggle privacy mute" Click="OnPrivacyClicked" Background="#A3424A"/>
              <TextBlock Text="Input devices" FontWeight="SemiBold" Margin="0,18,0,8"/>
              <ItemsControl x:Name="CaptureDevicesList"/>
              <TextBlock Text="Mutes monitored Windows input endpoints. Meeting-app mute indicators may differ. This is not a hardware privacy switch." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem x:Name="AssignmentsTab" Header="Assignments">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="Channels and processes" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="One process name per line; case-insensitive." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12"/>
              <StackPanel x:Name="MappingEditors"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="Audio sessions" FontSize="20" FontWeight="SemiBold"/>
              <Button Content="Refresh applications" Click="OnRefreshApplications" HorizontalAlignment="Left" Margin="0,8,0,4"/>
              <TextBlock Text="This list refreshes on request. Configured apps are detected automatically in the background." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
              <TextBlock Text="Double-click to add a process to the expanded channel." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12"/>
              <ListBox x:Name="SessionsList" Background="#111620" Foreground="{StaticResource TextBrush}" BorderThickness="0" MouseDoubleClick="OnSessionDoubleClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Controller &amp; settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="USB controller" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="COM port" Margin="0,16,0,5"/><ComboBox x:Name="PortCombo"/>
              <TextBlock Text="Baud rate" Margin="0,12,0,5"/><ComboBox x:Name="BaudCombo"><ComboBoxItem Content="9600"/><ComboBoxItem Content="115200"/></ComboBox>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Refresh ports" Click="OnRefreshPorts"/>
                <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClicked" Background="#286A62"/>
              </StackPanel>
              <TextBlock Text="Controller diagnostics" FontWeight="SemiBold" Margin="0,18,0,5"/>
              <TextBlock x:Name="RawValuesText" Text="A0 —   A1 —   A2 —   A3 —" FontFamily="Consolas"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
            <StackPanel>
              <TextBlock Text="Behavior" FontSize="20" FontWeight="SemiBold"/>
              <CheckBox x:Name="AutostartCheck" Content="Start with Windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <CheckBox x:Name="StartMinimizedCheck" Content="Start in tray at Windows sign-in" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <CheckBox x:Name="AllCaptureCheck" Content="Mute all active input devices" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
              <TextBlock Text="Mute follows Windows. External changes and newly connected inputs are reflected automatically; mute is not continuously enforced." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8"/>
              <CheckBox x:Name="ContinuousFadersCheck" Content="Continuously apply fader values" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="Reapply hardware levels on each feedback cycle, including newly started apps. Overrides external volume changes."/>
              <TextBlock Text="Controller heartbeat (ms, 50–5000)"/>
              <TextBox x:Name="HeartbeatText" TextChanged="OnSettingChanged"/>
              <TextBlock Text="PC feedback interval (ms, 100–2000)" Margin="0,8,0,0"/>
              <TextBox x:Name="FeedbackIntervalText" TextChanged="OnSettingChanged"/>
              <TextBlock Text="Display sleep (seconds, 0 = never)" Margin="0,14,0,5"/>
              <TextBox x:Name="DisplaySleepText" TextChanged="OnSettingChanged"/>
              <Button Content="Import legacy deej config.yaml" Click="OnImportYaml" Margin="0,20,0,0"/>
              <Button Content="Save settings" Click="OnSaveClicked" Background="#286A62"/>
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedTextBrush}"/>
      <TextBlock x:Name="BuildVersionText" Text="Deej Feedback 0.2.1-preview" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}"/>
    </Grid>
  </Grid>
</Window>
